Cell[BoxData[
 StyleBox[
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "best", " ", "model", " ", "to", " ", "use", " ", "gives", " ",
      "the", " ", "best", " ", "fit", " ", "to", " ", "the", " ", 
     RowBox[{"constants", ".", " ", "For"}], " ", "example"}], ",", " ", 
