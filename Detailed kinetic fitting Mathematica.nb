Cell["\<\
To make your calculations easier, copy/paste the values from the table to \
define your determined values and corresponding errors. \
\>", "Text",
 CellChangeTimes->{{3.953041832636829*^9, 
  3.953041892269704*^9}},ExpressionUUID->"116cebca-7cd3-4501-80ae-\
7179c9c48637"],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"kcatbestfitvalue", "=", "8.745560188093302`"}], ";"}],
  FontSize->16], "\[IndentingNewLine]", 
 StyleBox[
