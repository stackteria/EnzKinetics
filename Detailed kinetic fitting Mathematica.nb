  3.9530424101741323`*^9}},ExpressionUUID->"de566c88-ec1b-41f0-9747-\
fd4fbb4058a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Kmstandarderror", "=", 
   RowBox[{"Kmbestfitvalue", "*", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["kcatstandarderror", "kcatbestfitvalue"], ")"}], "2"], 
      "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["kspstandarderror", "kspbestfitvalue"], ")"}], 
       "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out2", "=", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Km std error = \>\"", ",", "Kmstandarderror", ",", 
      "\"\< \[Micro]M\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TextCell", "[", 
  RowBox[{"out2", ",", 
   RowBox[{"CellFrame", "->", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.929718425553698*^9, 3.929718518802578*^9}, {
