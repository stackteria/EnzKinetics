 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "sp"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "629e4b81-9f72-463e-8877-982b11fd8a74"],
 "from the table ",
 StyleBox["modeldata",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 ". "
}], "Text",
 CellChangeTimes->{{3.950530751195812*^9, 3.9505307782572727`*^9}, {
   3.9505308499131603`*^9, 3.950530940810131*^9}, 
