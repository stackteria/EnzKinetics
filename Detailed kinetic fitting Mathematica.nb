Cell[TextData[{
 "Now lets convert the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "sp"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98ed830a-bfb6-48ea-9387-f467972c8697"],
 "and its error so it has units of M",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fa22014-4d55-495c-b719-65d7863f2491"],
 "s",
