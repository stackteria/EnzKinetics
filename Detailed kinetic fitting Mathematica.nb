Cell[TextData[{
 "The code below extracts the best fit values and standard error for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "cat"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a57b0ce2-a045-4015-8cd8-a750db6fa901"],
