Cell[TextData[{
 "The ",
 StyleBox["Show",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " command allows you to show more than one thing on a single graph. In this \
case, we show a ",
 StyleBox["ListPlot[]",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " with every data trial (",
 StyleBox["fullData",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 ") to give some sense of the variability and use ",
 StyleBox["Plot[]",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 "to show the fitted equation. ",
 StyleBox["PlotRange",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " automatically defines the x and y axis boundaries using the maximum values \
of those data.  Remember to change the FrameLabel title to match the name of \
the substrate. To make sure the data plot automatically scales, there is a \
variable \[OpenCurlyDoubleQuote]sMax\[CloseCurlyDoubleQuote] that is defined \
to be 10% greater than the maximum concentration in the full data."
}], "Text",
 CellChangeTimes->{{3.821824686554537*^9, 3.821824745388989*^9}, 
