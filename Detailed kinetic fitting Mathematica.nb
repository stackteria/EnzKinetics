Cell[TextData[{
 "Below, the first command generates a model equation that fits the observed \
average data, requiring that ",
 StyleBox["kcat",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " and ",
 StyleBox["ksp",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " are positive numbers. The following command then reports the parameters as \
estimates and includes the standard error. "
}], "Text",
 CellChangeTimes->{{3.821824686554537*^9, 3.821824745388989*^9}, 
   3.821824844717708*^9, {3.859387409874918*^9, 3.8593874236751842`*^9}, {
   3.928937115247863*^9, 3.928937129605332*^9}, {3.928937457745533*^9, 
   3.9289374604813013`*^9}, {3.928937600367433*^9, 3.928937618719675*^9}, {
