Cell[TextData[{
 "Now select the rows for the average data and copy/paste to define that data \
sets (repeating for the full data). Adding a semicolon after the end of the \
commands tells Mathematica \[OpenCurlyDoubleQuote]do not display the output.\
\[CloseCurlyDoubleQuote] Notice that the variables ",
 StyleBox["avgData",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " and ",
 StyleBox["fullData",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " are shown in ",
 StyleBox["blue type",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " until you hit ",
 StyleBox["\[ShiftKey]",
  FontSize->24,
  FontWeight->"Normal",
  FontColor->RGBColor[0., 0., 0.]],
 " + ",
 StyleBox["\[EnterKey]",
  FontSize->24],
 ", at which point they become ",
 StyleBox["black",
  FontWeight->"Bold"],
 ". The black type indicates that the variable now has a value.  "
}], "Text",
 CellChangeTimes->{{3.821824686554537*^9, 3.821824745388989*^9}, 
