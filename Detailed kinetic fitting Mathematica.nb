Cell[TextData[{
 "The next calculation determines the error in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "m"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b7c8cde-eb38-410b-a87b-635b7e929bbd"],
 " using error propagation from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "cat"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01ba6a45-5831-4992-83f1-d816251fc52f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "sp"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d744837c-78f1-4706-8d39-72fc7253507f"],
 "."
}], "Text",
 CellChangeTimes->{{3.953041750854588*^9, 3.953041821227605*^9}, {
  3.953042074965357*^9, 3.953042158356995*^9}, {3.953042209279881*^9, 
