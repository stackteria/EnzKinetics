       "values", " ", "to", " ", 
      FormBox[
       SubscriptBox["k", "cat"],
       TraditionalForm], " ", "and", " ", 
      SubscriptBox["k", "SPH"], " ", "as", " ", "those", " ", "with", " ", 
      "ModifiedMM", " ", "and", " ", "with", " ", "n"}], "=", "1"}], ",", " ", 
    RowBox[{
    "but", " ", "with", " ", "worse", " ", "fits", " ", "to", " ", "the", " ",
      "constants"}], ",", " ", 
    RowBox[{
    "this", " ", "supports", " ", "a", " ", "model", " ", "without", " ", 
     "any", " ", "cooperativity"}], ",", " ", 
    RowBox[{
    "and", " ", "should", " ", "be", " ", "fit", " ", "using", " ", "the", " ", 
