 CellLabel->
  "In[439]:=",ExpressionUUID->"579e8402-77b3-4992-ab61-160c50445c4f"],

Cell[TextData[{
 "Note that the units on these values depend on your axes. Here I have \
plotted substrate concentration in \[Micro]M and the rate in s",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bf92a91-00e3-4510-bd7e-48cd3eb384aa"],
 ". The calculations below are to demonstrate how to report the kinetic \
constants. With these units, then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "cat"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4459558-03a5-444a-846b-beac80c0defc"],
 " has units of s",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "526354a6-4845-4675-ac5b-2a90f49e2515"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "sp"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b592680-027f-4f67-8271-84d6d11449e0"],
 " has units of \[Micro]M",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ffc06138-b2aa-498b-bb6c-85c1e4578fc6"],
 "s",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "087e2747-0522-4255-8cb8-a3ecff2c992c"],
 ". The first calculation determines ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "m"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a037b00-ae3a-408b-af68-988910358d4a"],
 " in units of \[Micro]M."
}], "Text",
 CellChangeTimes->{{3.953041750854588*^9, 3.953041821227605*^9}, {
  3.953042074965357*^9, 3.953042158356995*^9}, {3.953042209279881*^9, 
  3.953042284112174*^9}},ExpressionUUID->"f06d6fce-c40c-4c3e-8eed-\
26a326183f5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Kmbestfitvalue", "=", 
   FractionBox["kcatbestfitvalue", "kspbestfitvalue"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out1", "=", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Km = \>\"", ",", "Kmbestfitvalue", ",", "\"\< \[Micro]M\>\""}], 
     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TextCell", "[", 
  RowBox[{"out1", ",", 
   RowBox[{"CellFrame", "->", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.929718425553698*^9, 3.929718518802578*^9}, {
   3.929718563321354*^9, 3.929718565479478*^9}, {3.9297186557650003`*^9, 
