Cell[TextData[{
 "The ",
 StyleBox["NonLinearModelFit",
  FontFamily->"Courier New",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.]],
 " includes limits to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "cat"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "522240d3-063e-4020-a1af-45d9669da825"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "sp"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9bd37732-31d2-4d97-92b7-b258988a2a17"],
 ", indicating that they need to be greater than 0. If these bounds alone do \
not provide a good fit (i.e., the errors are large compared to the estimated \
parameters), add to or change these bounds so the model finds the true best \
fit. Recall that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "cat"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5f4a47ed-da07-4740-bca9-8121cf965bc3"],
 " indicates the upper limit of the velocity, and that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "sp"], TraditionalForm]],ExpressionUUID->
  "38482299-eb75-4e70-8b27-e641a20d9a1d"],
 " represent the initial linear portion of the curve. The command below \
demonstrates how to change the upper and lower bounds of the variables."
}], "Text",
 CellChangeTimes->{{3.929718267978724*^9, 3.92971841481321*^9}, {
   3.931610264899293*^9, 3.931610425917897*^9}, {3.931611645672571*^9, 
   3.93161168970722*^9}, 3.950267050491209*^9, 3.950518032005247*^9, {
   3.9505181105639057`*^9, 3.950518163763647*^9}, {3.950518304423668*^9, 
   3.9505183228818817`*^9}, {3.95304147173214*^9, 3.953041493310013*^9}, {
   3.953042166829062*^9, 3.953042191483181*^9}},
 FontSize->16,ExpressionUUID->"38f5614f-3845-40d7-8a89-b10cad6b8fa1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Model", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"avgData", ",", 
     RowBox[{"{", 
      RowBox[{"ModifiedMM", ",", 
       RowBox[{"kcat", ">", "4"}], ",", 
       RowBox[{"kcat", "<", "20"}], ",", 
       RowBox[{"ksp", ">", "0.01"}], ",", 
       RowBox[{"ksp", "<", "5"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kcat", ",", "ksp"}], "}"}], ",", "s"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"modeldata", "=", 
  RowBox[{"Model", "[", "\"\<ParameterTable\>\"", "]"}]}]}], "Input",
 CellChangeTimes->{{3.929718267978724*^9, 3.92971841481321*^9}, {
